# ---------------------------------------------------------------------------
# 绝不提交：真实供应商配置与凭据
# ---------------------------------------------------------------------------
# 真实的 providers.json 住在仓库之外的 %USERPROFILE%\.claude-sota\ 下。
# 这里的规则只是第二道防线，防止有人把它复制进工作区后误提交。
providers.json
providers.json.*
*.providers.json
auth.json
*.dpapi
config.toml
sota-multi-vendor-model-catalog.json
true-sota-model-catalog.json
.claude-sota/
.codex-sota/
.codex-plus/
.codex-personal/
claude-slot-claim.json
claude-library.lock
secrets/
*.key
*.pem
*.pfx
.env
.env.*

# ---------------------------------------------------------------------------
# 运行时状态：由程序生成，换台机器就没有意义
# ---------------------------------------------------------------------------
active-profile.json
last-result.json
sync.lock
work/
backups/
logs/
*.log
*.jsonl
session_index.jsonl
.codex-global-state.json
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-wal
*.db-shm
codex-sota.env.ps1

# ---------------------------------------------------------------------------
# 构建产物
# ---------------------------------------------------------------------------
dist/
dist-staging/
dist-staging.previous-*/
dist-candidate-*/
build-candidate-*/
codex-sota.old-*/
build/
.venv/
.venv-build/
.runtime/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.spec.bak

# ---------------------------------------------------------------------------
# Windows 快捷方式与编辑器/系统垃圾
# ---------------------------------------------------------------------------
*.lnk
.vscode/
.idea/
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/
